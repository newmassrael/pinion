#!/usr/bin/env bash
# pre-push hook — re-run integrity + lint gates before publishing
# commits to a remote.
#
# Push is the natural integrity-gate point: this is where the project's
# audit-traced state becomes shared. Catches state changes since last
# commit (manual atomic.json edits, amends, rebases, `--no-verify`
# bypasses) that pre-commit may have missed.
#
# Checks:
#
#   0. Commit-message lint (lib/commit-msg-lint.sh) for every commit being
#      pushed — the SAME rules the commit-msg hook enforces. commit-msg is
#      bypassable (`--no-verify`) and amend/rebase can reintroduce a
#      violation after it passed, so re-checking at the publish point closes
#      that hole (a multi-line body bullet, a 4th bullet, non-English text,
#      etc. cannot be published). Only commits ahead of the remote are
#      checked; published history is never re-litigated.
#
#   1. `mnemosyne-cli validate-workspace`
#      - T1 cross-ref orphan delta
#      - T2 frozen-ledger violations
#      - Atomic ledger consistency (entries / sections; store-direct since
#        Mnemosyne R400 retired the GENERATED.md round-trip)
#
#   2. `cargo clippy --workspace --all-targets --features pinion-runtime/vello`
#      - workspace.lints baseline: forbid unsafe / deny warnings /
#        clippy::pedantic deny
#      - unconditional (push validates the publishable state, so the
#        clippy budget is paid once per push regardless of which files
#        changed)
#
#   2b. `cargo doc --workspace --no-deps --document-private-items` (R1214,
#      R1218) — broken intra-doc link gate (unconditional). `warnings =
#      "deny"` makes rustdoc lints errors, so this fails on any broken /
#      redundant / private intra-doc link. `--document-private-items`
#      (R1218) extends the check to PRIVATE items' docs (~150 broken links
#      that public-items-only rustdoc never saw). Absent before R1214,
#      which let ~1000 links accrete from ~R683 unseen (ran clippy, never
#      rustdoc).
#
# Install via `git config core.hooksPath .githooks` (one-time per clone).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# --- 0. Commit-message gate (unconditional; cheapest, so run first) ---
# Re-validate the message of every commit being pushed with the SAME linter
# the commit-msg hook uses (lib/commit-msg-lint.sh). commit-msg can be
# bypassed with `--no-verify`, and an amend / rebase can reintroduce a
# violation after commit-msg already passed; pre-push is the publish gate, so
# re-checking here closes that hole (e.g. a multi-line body bullet that slips
# past `--no-verify` cannot be published). Only NEW commits — those ahead of
# the remote — are checked; already-published history is never re-litigated.
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/lib/commit-msg-lint.sh
source "$hook_dir/lib/commit-msg-lint.sh"
# shellcheck source=SCRIPTDIR/lib/ci-status.sh
source "$hook_dir/lib/ci-status.sh"
# shellcheck source=SCRIPTDIR/lib/consumer-tests.sh
source "$hook_dir/lib/consumer-tests.sh"
# R1507 — the pinned gate tool is resolved by this hook, not by PATH.
# shellcheck source=SCRIPTDIR/lib/mnemosyne-tool.sh
source "$hook_dir/lib/mnemosyne-tool.sh"

# --- R1495. The libraries this hook decides with, verified first ---
#
# These libs are what stands between a working tree and a remote, and until
# R1495 nothing checked any of them. They run in milliseconds, so the gate can
# afford to prove itself every time rather than being trusted because it used
# to work. Failing here fails the push: a gate that cannot pass its own tests
# is not evidence about anything else.
echo "pre-push: hook library tests ..." >&2
if ! bash "$repo_root/tools/test_hooks.sh" >&2; then
    echo "pre-push: the hook libraries failed their own tests" >&2
    exit 1
fi

# R1570.3 — the DEMO harness gets the same treatment, for the same reason and
# after the same cost. `tools/rpc_verify.py` drives every demo in the repo and
# nothing verified it: its teardown could let an exception escape while leaving
# the driven binary running, and in CI four such orphans turned four
# deterministic failures into thirty-seven that differed between runs. Runs in
# under a second — no cargo, no display.
echo "pre-push: demo harness lifecycle tests ..." >&2
if ! python3 "$repo_root/tools/test_rpc_verify.py" >&2; then
    echo "pre-push: the demo harness failed its own tests" >&2
    exit 1
fi

# R1588 — the population both focus sweeps census, checked against the tree it
# is derived from. The sweeps themselves are CI's job (they boot 92 windowed
# shells); what runs here is the derivation, because a population that has
# quietly narrowed makes those sweeps pass while covering less — which is
# exactly how a curated list of fourteen hid an absence in seventeen bindings
# for fifty rounds. Runs in well under a second: it reads source, boots nothing.
echo "pre-push: focus population derivation ..." >&2
if ! python3 "$repo_root/tools/test_binding_focus.py" >&2; then
    echo "pre-push: the shared focus population failed its own tests" >&2
    exit 1
fi

# R1601 — the reference census. The node-graph campaign's coverage claim is a
# count of what Blender and Unreal can do, and that count was a hand-written
# grep that was measurably wrong in BOTH directions: it missed 25 core operators
# (every Python one, including the whole zone family) and counted 11 macros —
# compositions of other operators — as capabilities. `--check-pin` needs no
# reference tree, which is what makes it a gate: the trees live outside this
# repo, but the JUDGEMENT is committed here and is the thing that rots.
echo "pre-push: reference census ..." >&2
if ! python3 "$repo_root/tools/reference_census.py" --selftest >&2; then
    echo "pre-push: the reference census failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/reference_census.py" --check-pin >&2; then
    echo "pre-push: docs/reference-census.json holds an unjudged operator" >&2
    exit 1
fi

# R1611 — the reference-name ratchet.
#
# A standing directive says other projects' names must not appear in what we
# publish. R1610 received it, zeroed its OWN output and registered the rest as
# debt, and nothing measured the rest: 7,999 occurrences across 501 files. A
# directive whose state nobody can see is a directive that grows. This makes the
# number monotone -- every push holds it or lowers it -- and refuses one that
# adds a name to a file, or a name to a file that had none.
echo "pre-push: reference names ..." >&2
if ! python3 "$repo_root/tools/reference_names.py" --selftest >&2; then
    echo "pre-push: the reference-name ratchet failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/reference_names.py" --check >&2; then
    exit 1
fi

# R1600.1 — the counterfactual driver. Counterfactual verification is this
# project's round-level discipline and until R1600 it had no mechanism: the
# driver was rewritten in a scratchpad each round, and R1599 built two defects
# into one copy of it, both of which reported success while being wrong (a case
# scoped to a single test, so PASSED meant "that test does not catch it"; and a
# classifier calling cargo's `error: test failed` a compile error). Its own
# tests assert each of the five properties those defects cost.
echo "pre-push: counterfactual driver ..." >&2
if ! python3 "$repo_root/tools/test_counterfactual.py" >&2; then
    echo "pre-push: the counterfactual driver failed its own tests" >&2
    exit 1
fi

# R1582 — the blast-radius computation the consumer gate rests on, checked
# against a synthetic workspace so its assertions state the graph they are
# about. A gate whose arithmetic nothing verifies is the shape R1522 fixed for
# the tally: the report ran, the tool's own selftest never did.
if ! python3 "$repo_root/tools/blast_radius.py" --selftest >&2; then
    echo "pre-push: the blast-radius computation failed its own tests" >&2
    exit 1
fi

msg_gate_failed=0
tmp_msg="$(mktemp)"
trap 'rm -f "$tmp_msg"' EXIT

# git feeds pre-push the ref updates on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
base_sha=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Branch deletion (local sha all-zero) — nothing to validate.
    [[ "$local_sha" =~ ^0+$ ]] && continue

    # The commit the remote is on right now: the one the CI verdict below is
    # supposed to be about. R1579 checks that it actually has a run.
    base_sha="$remote_sha"

    if [[ "$remote_sha" =~ ^0+$ ]]; then
        # New ref on the remote — validate only commits not already on any
        # remote-tracking ref, so a first push does not re-litigate history.
        range=("$local_sha" --not --remotes)
    else
        range=("$remote_sha..$local_sha")
    fi

    while read -r sha; do
        [[ -z "$sha" ]] && continue
        git log -1 --format=%B "$sha" >"$tmp_msg"
        if ! lint_commit_message "$tmp_msg"; then
            echo "pre-push: commit $sha violates COMMIT_FORMAT.md (above)" >&2
            msg_gate_failed=1
        fi
    done < <(git rev-list "${range[@]}")
done

if [[ "$msg_gate_failed" -ne 0 ]]; then
    echo "pre-push: one or more pushed commit messages violate COMMIT_FORMAT.md" >&2
    echo "pre-push: reword with 'git rebase -i', then re-push" >&2
    exit 1
fi

# --- R1495. Do not publish onto a base the last CI run said was broken ---
#
# The ratified rule is stop-the-line, and until now its only enforcement was a
# sentence in a gitignored file telling the next session to look. Runs before
# the build gates because it costs one `gh` call and refusing here saves the
# two minutes of clippy and rustdoc below. See lib/ci-status.sh for why it
# fails open on a missing `gh`, and for the override.
push_branch="$(git rev-parse --abbrev-ref HEAD)"
if ! check_last_ci_run "$push_branch" "pre-push"; then
    exit 1
fi

# --- R1579. That verdict is about SOME commit; say whether it is this base ---
#
# The check above reads the branch's last COMPLETED run and assumes the last
# thing CI judged is the thing being built on. Measured 2026-08-07: two pushes
# here produced no workflow run at all, so the gate inherited an older commit's
# green and said nothing. See lib/ci-status.sh for why this reports rather than
# refuses.
base_age=""
if [[ -n "$base_sha" && ! "$base_sha" =~ ^0+$ ]] &&
   base_committed="$(git log -1 --format=%ct "$base_sha" 2>/dev/null)"; then
    base_age="$(( $(date +%s) - base_committed ))"
fi
check_base_ci_coverage "$base_sha" "$push_branch" "pre-push" "$base_age"

# --- R1582. The tests of the packages this PUSH can break -------------------
#
# Repeated here for the reason every other gate is: an amend, a rebase or a
# `--no-verify` commit must not be able to publish a state pre-commit would
# have refused. Warm, so the second run costs seconds (measured 1.4s for eight
# already-built packages).
if [[ -n "$base_sha" && ! "$base_sha" =~ ^0+$ ]]; then
    if ! consumer_test_gate "pre-push" "$repo_root" range "$base_sha..HEAD"; then
        exit 1
    fi
fi

mnemosyne_resolve
echo "pre-push: mnemosyne-cli validate-workspace ($MN_CLI_SOURCE) ..." >&2
if ! mnemosyne_cli validate-workspace; then
    echo "pre-push: validate-workspace failed — fix violations before push" >&2
    exit 1
fi

echo "pre-push: cargo clippy --workspace --all-targets --features pinion-runtime/vello ..." >&2
# R1026 §6.3 — rustfmt gate (unconditional; push validates the publishable
# state). Runs before clippy so a formatting drift fails fast.
echo "pre-push: cargo fmt --all --check ..." >&2
if ! cargo fmt --all --check; then
    echo "pre-push: cargo fmt --check failed — run 'cargo fmt --all' before push" >&2
    exit 1
fi

if ! cargo clippy --workspace --all-targets --features pinion-runtime/vello; then
    echo "pre-push: clippy failed — fix violations before push" >&2
    exit 1
fi

# R1214 — broken intra-doc link gate (unconditional; push validates the
# publishable state). `warnings = "deny"` (workspace.lints) promotes rustdoc
# lints to errors, so a plain `cargo doc` fails on any broken/redundant/private
# intra-doc link. Absent until R1214 — the reason ~1000 links accreted from
# ~R683 unseen (the gate ran clippy, never rustdoc). Near-free once clippy has
# warmed the build.
echo "pre-push: cargo doc --workspace --no-deps --document-private-items ..." >&2
if ! cargo doc --workspace --no-deps --features pinion-runtime/vello --document-private-items; then
    echo "pre-push: cargo doc failed — fix broken intra-doc links before push" >&2
    exit 1
fi

# 3. validate-code-refs — hallucination-class citation gate (unconditional;
#    push validates the publishable state). Output captured, surfaced only on
#    failure (the info-level Path B binding axis is verbose).
echo "pre-push: mnemosyne-cli validate-code-refs ..." >&2
if ! cr_out="$(mnemosyne_cli validate-code-refs 2>&1)"; then
    printf '%s\n' "$cr_out" | grep -E '\[(missing|section_missing)\]|violations: total' >&2 || true
    echo "pre-push: validate-code-refs found hallucination-class citations" >&2
    exit 1
fi

# 4. R1486 — report and bound the build cache THIS hook creates.
#
# Deliberately last. The clippy and rustdoc gates above build the workspace,
# so their artifacts are the newest in `target/` and an oldest-first sweep
# cannot remove them; running this before them would delete artifacts the
# very next command rebuilds. See lib/target-budget.sh for why the bound is
# on size rather than age, and for what this does NOT guarantee.
#
# Never fails the push: the commit being published is not what is unsafe.
# shellcheck source=SCRIPTDIR/lib/target-budget.sh
source "$hook_dir/lib/target-budget.sh"
enforce_target_budget "$repo_root" "pre-push"

# 5. R1519 — report whether the Phase B progress judgment still describes the
# tree. `CLAUDE.md` carried "~56%" from a tally made at R931 and held it for 587
# rounds while examples grew +71% and demos +108%; nothing ever said the number
# had stopped being a measurement. This prints the axis judgments and shouts
# when the evidence one rests on has drifted past the tool's threshold.
#
# Reports, never fails — same reasoning as the cache budget above: a stale
# self-estimate is not a reason to refuse a push. The value is that the number
# is spoken every time, so its going stale is visible the round it happens
# rather than 587 rounds later.
#
# R1522 lifted this out of the hook body, because the inline form ran the
# tool's report while never running the tool's own `--selftest`, and swallowed
# stderr and the exit code so a broken tally printed nothing at all. See
# lib/phase-b-tally.sh; it is covered by tools/test_hooks.sh above.
# shellcheck source=SCRIPTDIR/lib/phase-b-tally.sh
source "$hook_dir/lib/phase-b-tally.sh"
report_phase_b_tally "$repo_root"

exit 0
