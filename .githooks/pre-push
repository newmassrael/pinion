#!/usr/bin/env bash
# pre-push hook — re-run integrity + lint gates before publishing
# commits to a remote.
#
# Push is the natural integrity-gate point: this is where the project's
# audit-traced state becomes shared. Catches state changes since last
# commit (manual atomic.json edits, amends, rebases, `--no-verify`
# bypasses) that pre-commit may have missed.
#
# Checks:
#
#   0. Commit-message lint (lib/commit-msg-lint.sh) for every commit being
#      pushed — the SAME rules the commit-msg hook enforces. commit-msg is
#      bypassable (`--no-verify`) and amend/rebase can reintroduce a
#      violation after it passed, so re-checking at the publish point closes
#      that hole (a multi-line body bullet, a 4th bullet, non-English text,
#      etc. cannot be published). Only commits ahead of the remote are
#      checked; published history is never re-litigated.
#
#   1. `mnemosyne-cli validate-workspace`
#      - T1 cross-ref orphan delta
#      - T2 frozen-ledger violations
#      - Atomic ledger consistency (entries / sections; store-direct since
#        Mnemosyne R400 retired the GENERATED.md round-trip)
#
#   2. `cargo clippy --workspace --all-targets --features pinion-runtime/vello`
#      - workspace.lints baseline: forbid unsafe / deny warnings /
#        clippy::pedantic deny
#      - unconditional (push validates the publishable state, so the
#        clippy budget is paid once per push regardless of which files
#        changed)
#
#   2b. ⚠ NOT HERE — the broken intra-doc link gate (R1214, R1218) runs in
#      `.github/workflows/ci.yml` and nowhere else, since R1779. This list
#      claimed otherwise until R1782, which is the shape of staleness a
#      hand-maintained list of a program's own steps always takes: ask the
#      hook instead (see the CLAUDE.md note that derives the step list from
#      a push log). CI is its ONLY home, so `tools/test_hooks.sh` asserts
#      it is still there.
#
# Install via `git config core.hooksPath .githooks` (one-time per clone).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# --- 0. Commit-message gate (unconditional; cheapest, so run first) ---
# Re-validate the message of every commit being pushed with the SAME linter
# the commit-msg hook uses (lib/commit-msg-lint.sh). commit-msg can be
# bypassed with `--no-verify`, and an amend / rebase can reintroduce a
# violation after commit-msg already passed; pre-push is the publish gate, so
# re-checking here closes that hole (e.g. a multi-line body bullet that slips
# past `--no-verify` cannot be published). Only NEW commits — those ahead of
# the remote — are checked; already-published history is never re-litigated.
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/lib/commit-msg-lint.sh
source "$hook_dir/lib/commit-msg-lint.sh"
# shellcheck source=SCRIPTDIR/lib/ci-status.sh
source "$hook_dir/lib/ci-status.sh"
# shellcheck source=SCRIPTDIR/lib/consumer-tests.sh
source "$hook_dir/lib/consumer-tests.sh"
# R1507 — the pinned gate tool is resolved by this hook, not by PATH.
# shellcheck source=SCRIPTDIR/lib/mnemosyne-tool.sh
source "$hook_dir/lib/mnemosyne-tool.sh"
# shellcheck source=SCRIPTDIR/lib/worktree-guard.sh
source "$hook_dir/lib/worktree-guard.sh"

# --- R1495. The libraries this hook decides with, verified first ---
#
# These libs are what stands between a working tree and a remote, and until
# R1495 nothing checked any of them. Failing here fails the push: a gate that
# cannot pass its own tests is not evidence about anything else.
#
# ⚠ NOT "milliseconds", which is what this comment claimed until R1782. Timed
# at R1779: 65.83s, the single largest step anyone has attributed in this hook.
# The claim was never measured — it was inferred from "plain bash" — and the
# CLAUDE.md copy of it was corrected while this one, the original, was not.
echo "pre-push: hook library tests ..." >&2
if ! bash "$repo_root/tools/test_hooks.sh" >&2; then
    echo "pre-push: the hook libraries failed their own tests" >&2
    exit 1
fi

# --- R1782. The transport this hook's own duration depends on ---
#
# git opens the connection to the remote BEFORE running this hook, so a hook
# that takes minutes leaves a socket idle for that long. Seven consecutive
# pushes died `rc=141` (SIGPIPE) after every gate had PASSED — the worst shape
# a failure can take, because `git log` looks finished while `origin/main` has
# not moved. R1782 restored clippy here, which makes the keepalive load-bearing
# rather than incidental; measured the same round, it was living in one shell's
# command line, with `core.sshCommand` and `GIT_SSH_COMMAND` both empty.
#
# Sits here, after the library tests, for the reason the worktree guard does:
# this hook does not decide with a library it has not verified. One `git
# config` call.
#
# Refuses rather than prints, because a printed reminder is exactly what the
# seven failures already had.
# shellcheck source=SCRIPTDIR/lib/ssh-keepalive.sh
source "$hook_dir/lib/ssh-keepalive.sh"
if [[ "${PINION_ALLOW_NO_KEEPALIVE:-}" != "1" ]]; then
    _ka_url="$(git config --get "remote.${1:-origin}.url" 2>/dev/null || true)"
    if [[ "$(keepalive_verdict "$_ka_url" "$(keepalive_configured_command)")" == "missing" ]]; then
        echo "pre-push: this hook runs for minutes and the ssh connection is ALREADY open." >&2
        echo "pre-push: with no keepalive the remote closes it and the push dies rc=141" >&2
        echo "pre-push: AFTER every gate has passed. Configure it once, in this clone:" >&2
        echo "  git config --local core.sshCommand 'ssh -o ServerAliveInterval=20 -o ServerAliveCountMax=60 -o TCPKeepAlive=yes'" >&2
        echo "pre-push: override with PINION_ALLOW_NO_KEEPALIVE=1 if ~/.ssh/config sets it" >&2
        echo "pre-push: (git never reports that file, so this check cannot see it)" >&2
        exit 1
    fi
fi

# A round is published from the main tree; exploration worktrees may not push.
# This sits AFTER the library tests on purpose -- the rule just above is that
# this hook does not decide with libraries it has not verified, and the guard is
# one of them. It costs two `rev-parse` calls, so buying that ordering is free.
require_main_worktree_for push || exit 1

# The tool that CREATES those worktrees gets the same treatment as every other
# tool this repo gates with. Four things about this machine do not follow a bare
# `git worktree add` and all four fail quietly -- the `target/` symlink onto the
# fixed-size compressed volume, submodule population, the shared headless
# display number, and teardown -- so a session that hand-rolls one instead
# rebuilds the 2026-07-29 full-disk precondition. That makes the script load
# bearing, and a load-bearing script whose own tests nobody runs is the thing
# this hook exists to prevent. Milliseconds, no git, no writes.
echo "pre-push: worktree tool selftest ..." >&2
if ! bash "$repo_root/tools/worktree.sh" --selftest >&2; then
    echo "pre-push: the worktree tool failed its own tests" >&2
    exit 1
fi

# R1570.3 — the DEMO harness gets the same treatment, for the same reason and
# after the same cost. `tools/rpc_verify.py` drives every demo in the repo and
# nothing verified it: its teardown could let an exception escape while leaving
# the driven binary running, and in CI four such orphans turned four
# deterministic failures into thirty-seven that differed between runs. Runs in
# under a second — no cargo, no display.
echo "pre-push: demo harness lifecycle tests ..." >&2
if ! python3 "$repo_root/tools/test_rpc_verify.py" >&2; then
    echo "pre-push: the demo harness failed its own tests" >&2
    exit 1
fi

# R1588 — the population both focus sweeps census, checked against the tree it
# is derived from. The sweeps themselves are CI's job (they boot 92 windowed
# shells); what runs here is the derivation, because a population that has
# quietly narrowed makes those sweeps pass while covering less — which is
# exactly how a curated list of fourteen hid an absence in seventeen bindings
# for fifty rounds. Runs in well under a second: it reads source, boots nothing.
echo "pre-push: focus population derivation ..." >&2
if ! python3 "$repo_root/tools/test_binding_focus.py" >&2; then
    echo "pre-push: the shared focus population failed its own tests" >&2
    exit 1
fi

# R1601 — the reference census. The node-graph campaign's coverage claim is a
# count of what the DCC and the engine can do, and that count was a hand-written
# grep that was measurably wrong in BOTH directions: it missed 25 core operators
# (every Python one, including the whole zone family) and counted 11 macros —
# compositions of other operators — as capabilities. `--check-pin` needs no
# reference tree, which is what makes it a gate: the trees live outside this
# repo, but the JUDGEMENT is committed here and is the thing that rots.
# R1646 — the analysis-tool census. The node-graph axis has had a meter since
# R1601; the analysis-tool axis had a prose table in a session note, and prose
# drifts: measured twice in one session, it called the charting remainder "3D
# only" while a label-thinning gap sat in it, and it listed the two-layer link
# diff as closed when what existed was the paint and the model was inside an
# example. Both are the failure the other census exists to prevent. This gate
# holds the judgement to a shape — every declared capability carries a verdict
# from a closed set, a `have` names what covers it, and `unmeasured` is a
# verdict rather than a silence.
echo "pre-push: analysis-tool census ..." >&2
if ! python3 "$repo_root/tools/analyzer_census.py" --selftest >&2; then
    echo "pre-push: the analysis-tool census failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/analyzer_census.py" --check-pin >&2; then
    echo "pre-push: docs/analyzer-census.json is malformed" >&2
    exit 1
fi
# ★★★★★ R1771 — and the PROOFS, against the test runner rather than a search.
# The pin's `assembled_by` has had every path it names checked since R1648;
# `proven_by` — which carries the census's strongest claim, that a capability
# was exercised through the public API — was checked for nothing at all, so a
# citation to a renamed or deleted test passed silently on the rows a reader
# trusts most. Measured R1771: 3.5s on a warm tree, and the first time after a
# clean build it pays for the cited crates' test binaries once.
if ! python3 "$repo_root/tools/analyzer_census.py" --check-proofs >&2; then
    echo "pre-push: a proof the analysis-tool census cites is not a test that runs" >&2
    exit 1
fi

echo "pre-push: reference census ..." >&2
if ! python3 "$repo_root/tools/reference_census.py" --selftest >&2; then
    echo "pre-push: the reference census failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/reference_census.py" --check-pin >&2; then
    echo "pre-push: docs/reference-census.json holds an unjudged operator" >&2
    exit 1
fi

# R1611 — the reference-name ratchet.
#
# A standing directive says other projects' names must not appear in what we
# publish. R1610 received it, zeroed its OWN output and registered the rest as
# debt, and nothing measured the rest: 7,999 occurrences across 501 files. A
# directive whose state nobody can see is a directive that grows. This makes the
# number monotone -- every push holds it or lowers it -- and refuses one that
# adds a name to a file, or a name to a file that had none.
echo "pre-push: reference names ..." >&2
if ! python3 "$repo_root/tools/reference_names.py" --selftest >&2; then
    echo "pre-push: the reference-name ratchet failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/reference_names.py" --check >&2; then
    exit 1
fi

# R1659 -- a consumer that speaks only the JSON-RPC wire links no font stack.
#
# parley's default `system` feature makes the fontconfig development headers a
# BUILD requirement of anything reaching `pinion-text`, and a wire-only consumer
# reaches it through `pinion-rpc`. The property is a closure over the dependency
# graph, not a fact about one manifest: `pinion-rpc` has TWO paths to the text
# stack, which is why the reported fix -- gate the deps this crate declares --
# would have left the build broken. A third path is one ordinary-looking
# `Cargo.toml` line away and nobody would see it.
echo "pre-push: wire-only deps ..." >&2
if ! python3 "$repo_root/tools/wire_only_deps.py" --selftest >&2; then
    echo "pre-push: the wire-only dep gate failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/wire_only_deps.py" --check >&2; then
    exit 1
fi

# R1746 — the round ledger, which CLAUDE.md calls the decision audit trail and
# nothing has ever checked.
#
# `docs/phase-b-rounds.tsv` is the other once-per-round artifact and it IS
# checked (the tally prints UNDECLARED below). The difference is measurable: at
# R1746 the TSV had a row for every round git has and the changelog had no entry
# for R1743, R1744 or R1745 — a gated artifact continued, an ungated one stopped.
#
# The round in progress is exempt (a round legitimately pushes before it closes),
# so what this refuses is publishing a round while an EARLIER one is still
# unrecorded. It also refuses a changelog key whose form the reader does not
# know, because a key it cannot read is a round it would silently miscount —
# which is how R1744 came to record a 34-round outage that did not exist. Reads
# git log and the store's keys; boots nothing (~0.3s).
# R1783 — the demo clock's UNIT. `tick(dt)` takes SECONDS and 172 sites
# across 28 demos were written `tick(16)`, meaning one frame at 60 fps; that
# call advances SIXTEEN SECONDS.
#
# It was invisible for as long as overshooting cost nothing — a 200 ms fade
# settles the same either way, which `tick()`'s own docstring blesses. It
# became visible the round a lifetime started being told the truth: before
# R1778 the analyzer shell's 2.6 s toast left the SCREEN on expiry while the
# WIRE went on reporting the sentence, so eight demos passed by reading
# something the screen had stopped showing. R1778 made the two agree and all
# eight went red.
#
# Pins the backlog rather than demanding zero: a count may fall or hold, and
# a file may not acquire its first. Reads source with `ast`; boots nothing.
echo "pre-push: demo clock units ..." >&2
if ! python3 "$repo_root/tools/tick_units.py" --selftest >&2; then
    echo "pre-push: the demo-clock ratchet failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/tick_units.py" --check >&2; then
    exit 1
fi

echo "pre-push: round ledger ..." >&2
if ! python3 "$repo_root/tools/changelog_rounds.py" --selftest >&2; then
    echo "pre-push: the round-ledger gate failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/changelog_rounds.py" --check >&2; then
    echo "pre-push: append the missing entry with mnemosyne-cli, then re-push" >&2
    exit 1
fi

# R1600.1 — the counterfactual driver. Counterfactual verification is this
# project's round-level discipline and until R1600 it had no mechanism: the
# driver was rewritten in a scratchpad each round, and R1599 built two defects
# into one copy of it, both of which reported success while being wrong (a case
# scoped to a single test, so PASSED meant "that test does not catch it"; and a
# classifier calling cargo's `error: test failed` a compile error). Its own
# tests assert each of the five properties those defects cost.
echo "pre-push: counterfactual driver ..." >&2
if ! python3 "$repo_root/tools/test_counterfactual.py" >&2; then
    echo "pre-push: the counterfactual driver failed its own tests" >&2
    exit 1
fi

# R1582 — the blast-radius computation the consumer gate rests on, checked
# against a synthetic workspace so its assertions state the graph they are
# about. A gate whose arithmetic nothing verifies is the shape R1522 fixed for
# the tally: the report ran, the tool's own selftest never did.
if ! python3 "$repo_root/tools/blast_radius.py" --selftest >&2; then
    echo "pre-push: the blast-radius computation failed its own tests" >&2
    exit 1
fi

# R1797 — the DEMO half of the same computation. `blast_radius.py` answers which
# packages a change can break; this answers which demos, which is where a wire
# claim is actually asserted and where R1795's published red came from — six of
# 645 demos were not on a list somebody wrote by hand. Its selftest checks that
# the parse still resolves launch targets and that every name it resolves is a
# real example, so a rename that quietly emptied the mapping fails here instead
# of turning the tool into a shorter hand-written list.
echo "pre-push: demo radius selftest ..." >&2
if ! python3 "$repo_root/tools/demo_radius.py" --selftest >&2; then
    echo "pre-push: the demo-radius computation failed its own tests" >&2
    exit 1
fi

# R1798 — the same class one property over: `r1712`'s gate reads a screen's
# concession verdict and refuses `unreachable`, and its population was a
# hand-written list of three. Two screens grew a policy later, were never added,
# and had been reporting the one verdict the framework calls inexcusable. This
# derives the set from the sources and fails when the demo is short.
echo "pre-push: shrink population ..." >&2
if ! python3 "$repo_root/tools/shrink_population.py" --selftest >&2; then
    echo "pre-push: the shrink-population computation failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/shrink_population.py" --check >&2; then
    echo "pre-push: a screen declares a shrink policy and no gate asks it" >&2
    exit 1
fi

# R1641 — the SCE dual pin: `Cargo.toml`'s rev, this repo's `Cargo.lock`, and
# the `vendor/sce` submodule gitlink are three statements of one fact, and until
# now the only thing holding them together was a comment in `Cargo.toml`
# carrying a shell one-liner for whoever remembered to run it. The Mnemosyne
# pin got the mechanical treatment at R1508; `.githooks/lib/mnemosyne-tool.sh`
# describes that as "the same dual discipline `vendor/sce` has, made
# mechanical", which names in passing that this one was not.
#
# Drifting them apart splits the SCE instance in any consumer that rev-pins
# pinion — the failure `Cargo.toml`'s own comment describes, and one that
# surfaces as an `Engine`/`StatePolicy` type mismatch a long way from its cause.
# Reads three files and the index; boots nothing.
if ! python3 "$repo_root/tools/test_pin_sync.py" >&2; then
    echo "pre-push: the pin-sync gate failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/pin_sync.py" --check-dual-pin >&2; then
    echo "pre-push: pinion's SCE pin disagrees with itself" >&2
    exit 1
fi

msg_gate_failed=0
tmp_msg="$(mktemp)"
# R1779 — every path this push publishes, accumulated across the ref updates.
tmp_paths="$(mktemp)"
trap 'rm -f "$tmp_msg" "$tmp_paths"' EXIT

# git feeds pre-push the ref updates on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
base_sha=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Branch deletion (local sha all-zero) — nothing to validate.
    [[ "$local_sha" =~ ^0+$ ]] && continue

    # The commit the remote is on right now: the one the CI verdict below is
    # supposed to be about. R1579 checks that it actually has a run.
    base_sha="$remote_sha"

    if [[ "$remote_sha" =~ ^0+$ ]]; then
        # New ref on the remote — validate only commits not already on any
        # remote-tracking ref, so a first push does not re-litigate history.
        range=("$local_sha" --not --remotes)
    else
        range=("$remote_sha..$local_sha")
    fi

    while read -r sha; do
        [[ -z "$sha" ]] && continue
        git log -1 --format=%B "$sha" >"$tmp_msg"
        if ! lint_commit_message "$tmp_msg"; then
            echo "pre-push: commit $sha violates COMMIT_FORMAT.md (above)" >&2
            msg_gate_failed=1
        fi
    done < <(git rev-list "${range[@]}")

    # ★ R1779 — the paths this push actually touches, for the gates below that
    # only have something to say about some of them. Collected from the SAME
    # range the message lint walks, so a gate cannot disagree with it about
    # what is being published.
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        git diff --name-only "$(git rev-list --max-parents=0 "$local_sha" | tail -1)" "$local_sha" >>"$tmp_paths" 2>/dev/null || true
    else
        git diff --name-only "$remote_sha" "$local_sha" >>"$tmp_paths" 2>/dev/null || true
    fi
done

if [[ "$msg_gate_failed" -ne 0 ]]; then
    echo "pre-push: one or more pushed commit messages violate COMMIT_FORMAT.md" >&2
    echo "pre-push: reword with 'git rebase -i', then re-push" >&2
    exit 1
fi

# --- R1495. Do not publish onto a base the last CI run said was broken ---
#
# The ratified rule is stop-the-line, and until now its only enforcement was a
# sentence in a gitignored file telling the next session to look. Runs before
# the build gates because it costs one `gh` call and refusing here saves the
# two minutes of clippy and rustdoc below. See lib/ci-status.sh for why it
# fails open on a missing `gh`, and for the override.
push_branch="$(git rev-parse --abbrev-ref HEAD)"
if ! check_last_ci_run "$push_branch" "pre-push"; then
    exit 1
fi

# --- R1579. That verdict is about SOME commit; say whether it is this base ---
#
# The check above reads the branch's last COMPLETED run and assumes the last
# thing CI judged is the thing being built on. Measured 2026-08-07: two pushes
# here produced no workflow run at all, so the gate inherited an older commit's
# green and said nothing. See lib/ci-status.sh for why this reports rather than
# refuses.
base_age=""
if [[ -n "$base_sha" && ! "$base_sha" =~ ^0+$ ]] &&
   base_committed="$(git log -1 --format=%ct "$base_sha" 2>/dev/null)"; then
    base_age="$(( $(date +%s) - base_committed ))"
fi
check_base_ci_coverage "$base_sha" "$push_branch" "pre-push" "$base_age"

# --- R1582. The tests of the packages this PUSH can break -------------------
#
# Repeated here for the reason every other gate is: an amend, a rebase or a
# `--no-verify` commit must not be able to publish a state pre-commit would
# have refused. Warm, so the second run costs seconds (measured 1.4s for eight
# already-built packages).
if [[ -n "$base_sha" && ! "$base_sha" =~ ^0+$ ]]; then
    if ! consumer_test_gate "pre-push" "$repo_root" range "$base_sha..HEAD"; then
        exit 1
    fi
fi

mnemosyne_resolve
echo "pre-push: mnemosyne-cli validate-workspace ($MN_CLI_SOURCE) ..." >&2
if ! mnemosyne_cli validate-workspace; then
    echo "pre-push: validate-workspace failed — fix violations before push" >&2
    exit 1
fi

# R1026 §6.3 — rustfmt gate (unconditional; push validates the publishable
# state). Cheap, and formatting drift is what makes a diff unreadable.
echo "pre-push: cargo fmt --all --check ..." >&2
if ! cargo fmt --all --check; then
    echo "pre-push: cargo fmt --check failed — run 'cargo fmt --all' before push" >&2
    exit 1
fi

# ★★★★★ R1782 — CLIPPY IS BACK HERE. RUSTDOC STAYS IN CI.
#
# R1779 removed the two together and justified it with ONE number: a fully
# warmed pre-push took 237.33s. That number was never split between them, and
# split it does not say what R1779 said. Timed on this tree, one variable at a
# time:
#
#   clippy, nothing changed since the last run ......   4.6s
#   clippy, after an edit that invalidates the graph   119.6s
#   rustdoc, same tree, started right after that ....  394.6s
#
# 86x apart. 4.6s is not "the whole cost of a commit". R1779's own commit body
# already recorded the tell — removing clippy made the hook SLOWER, because the
# emit ratchet had been riding its warm build — and the round wrote that down
# while still treating the pair as one item.
#
# ⚠ AND THE PAIR IS NOT A PAIR. R1779's comment said rustdoc is cheap only once
# clippy has warmed the build. That 394.6s run was started immediately after a
# complete clippy run on this tree and spent minutes checking dependency crates
# clippy had just checked: clippy writes clippy-driver rmeta and rustdoc cannot
# read it. They do not warm each other, so bundling them charged the cheap gate
# the expensive one's bill.
#
# WHAT THE SPLIT COSTS, on the evidence of the round that paid for it: R1780
# published FOUR pedantic violations across two crates, CI went red, and
# stop-the-line then refused R1781 — so the trade did not cost a violation, it
# cost a ROUND. Against that, up to two minutes on a push that touched a core
# crate is cheap; the frequency is right too, since what this protects is what
# gets PUBLISHED, which is why it is here and not in `pre-commit`.
#
# Rustdoc stays in CI: its cost is real and its failure mode (a broken
# intra-doc link) does not compile-break a consumer.
echo "pre-push: cargo clippy --workspace --all-targets --features pinion-runtime/vello ..." >&2
if ! cargo clippy --workspace --all-targets --features pinion-runtime/vello; then
    echo "pre-push: clippy failed — fix violations before push" >&2
    exit 1
fi

# R1766 — the committed statechart emit. `crates/pinion-core/generated/` is
# tracked now rather than produced into OUT_DIR on every build, and `build.rs`
# compares the SCE drift hashes on every build, which catches a chart edited
# without regenerating. What hashes over the INPUTS cannot catch is a
# hand-edited emit or a generator gone non-deterministic — neither moves an
# input hash. This is that half: a byte comparison against a fresh run of the
# pinned generator. It is a ratchet rather than a test suite, which is why it
# runs here and not only in CI.
#
# ★★★★★ R1779 — AND IT RUNS ONLY WHEN THE PUSH COULD HAVE STALED IT, which the
# round that moved clippy out had to discover by measuring.
#
# Its own note used to end "near-free once clippy has warmed the build (the
# three assertions themselves measured 0.16s)". That was true and it was
# LOAD-BEARING: the assertions are free, the BUILD behind them is not. With
# clippy gone this step compiles the SCE chain itself — `libxml`, bindgen,
# `sce-build`, `pinion-forge` — and a fully warmed hook went from 237s to
# **830s**. Moving the heavy pair to CI did not remove the compilation; it moved
# it to a step that pays for it alone.
#
# The emit can only go stale if a chart, the committed emit, the pinned
# generator or the pin itself moved. So it is gated on exactly those paths, the
# way `pre-commit`'s clippy was gated on `*.rs`, and an ordinary push now does
# no compiling at all. A push that DOES touch them pays the build — which is
# the push that needs the ratchet.
if grep -qE '(\.scxml$|^crates/pinion-core/generated/|^crates/pinion-core/build\.rs$|^vendor/sce$|^Cargo\.(toml|lock)$)' "$tmp_paths"; then
    echo "pre-push: statechart emit matches the pinned generator ..." >&2
    if ! cargo test -p pinion-core --test statechart_emit; then
        echo "pre-push: the committed statechart emit is stale or hand-edited — run" >&2
        echo "  PINION_REGEN_STATECHARTS=1 cargo test -p pinion-core --test statechart_emit" >&2
        exit 1
    fi
else
    echo "pre-push: statechart emit — no chart, emit, generator or pin in this push" >&2
fi

# R1214's intra-doc link gate moved to CI with clippy in R1779 — see the note
# above, and `pre-commit` for why the two are one unit. The history is worth
# keeping either way: nothing ran rustdoc until R1214, which is how ~1000 broken
# links accreted from ~R683 unseen. A lint that is configured is not a lint that
# is run.

# 3. validate-code-refs — hallucination-class citation gate (unconditional;
#    push validates the publishable state). Output captured, surfaced only on
#    failure (the info-level Path B binding axis is verbose).
echo "pre-push: mnemosyne-cli validate-code-refs ..." >&2
if ! cr_out="$(mnemosyne_cli validate-code-refs 2>&1)"; then
    printf '%s\n' "$cr_out" | grep -E '\[(missing|section_missing)\]|violations: total' >&2 || true
    echo "pre-push: validate-code-refs found hallucination-class citations" >&2
    exit 1
fi

# 4. R1486 — report and bound the build cache THIS hook creates.
#
# Deliberately last. The clippy and rustdoc gates above build the workspace,
# so their artifacts are the newest in `target/` and an oldest-first sweep
# cannot remove them; running this before them would delete artifacts the
# very next command rebuilds. See lib/target-budget.sh for why the bound is
# on size rather than age, and for what this does NOT guarantee.
#
# Never fails the push: the commit being published is not what is unsafe.
# shellcheck source=SCRIPTDIR/lib/target-budget.sh
source "$hook_dir/lib/target-budget.sh"
enforce_target_budget "$repo_root" "pre-push"

# 5. R1519 — report whether the Phase B progress judgment still describes the
# tree. `CLAUDE.md` carried "~56%" from a tally made at R931 and held it for 587
# rounds while examples grew +71% and demos +108%; nothing ever said the number
# had stopped being a measurement. This prints the axis judgments and shouts
# when the evidence one rests on has drifted past the tool's threshold.
#
# Reports, never fails — same reasoning as the cache budget above: a stale
# self-estimate is not a reason to refuse a push. The value is that the number
# is spoken every time, so its going stale is visible the round it happens
# rather than 587 rounds later.
#
# R1522 lifted this out of the hook body, because the inline form ran the
# tool's report while never running the tool's own `--selftest`, and swallowed
# stderr and the exit code so a broken tally printed nothing at all. See
# lib/phase-b-tally.sh; it is covered by tools/test_hooks.sh above.
# shellcheck source=SCRIPTDIR/lib/phase-b-tally.sh
source "$hook_dir/lib/phase-b-tally.sh"
report_phase_b_tally "$repo_root"

exit 0
