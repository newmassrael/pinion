#!/usr/bin/env bash
# pre-push hook — re-run integrity + lint gates before publishing
# commits to a remote.
#
# Push is the natural integrity-gate point: this is where the project's
# audit-traced state becomes shared. Catches state changes since last
# commit (manual atomic.json edits, amends, rebases, `--no-verify`
# bypasses) that pre-commit may have missed.
#
# Checks:
#
#   1. `mnemosyne-cli validate-workspace`
#      - T1 cross-ref orphan delta
#      - T2 frozen-ledger violations
#      - Atomic ledger consistency (entries / sections; store-direct since
#        Mnemosyne R400 retired the GENERATED.md round-trip)
#
#   2. `cargo clippy --workspace --all-targets --features pinion-runtime/vello`
#      - workspace.lints baseline: forbid unsafe / deny warnings /
#        clippy::pedantic deny
#      - unconditional (push validates the publishable state, so the
#        clippy budget is paid once per push regardless of which files
#        changed)
#
# Install via `git config core.hooksPath .githooks` (one-time per clone).
set -euo pipefail

if ! command -v mnemosyne-cli >/dev/null 2>&1; then
    echo "pre-push: mnemosyne-cli not on PATH — install with" >&2
    echo "  cargo install --path /path/to/mnemosyne/crates/mnemosyne-cli" >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: mnemosyne-cli validate-workspace ..." >&2
if ! mnemosyne-cli validate-workspace; then
    echo "pre-push: validate-workspace failed — fix violations before push" >&2
    exit 1
fi

echo "pre-push: cargo clippy --workspace --all-targets --features pinion-runtime/vello ..." >&2
# R1026 §6.3 — rustfmt gate (unconditional; push validates the publishable
# state). Runs before clippy so a formatting drift fails fast.
echo "pre-push: cargo fmt --all --check ..." >&2
if ! cargo fmt --all --check; then
    echo "pre-push: cargo fmt --check failed — run 'cargo fmt --all' before push" >&2
    exit 1
fi

if ! cargo clippy --workspace --all-targets --features pinion-runtime/vello; then
    echo "pre-push: clippy failed — fix violations before push" >&2
    exit 1
fi

# 3. validate-code-refs — hallucination-class citation gate (unconditional;
#    push validates the publishable state). Output captured, surfaced only on
#    failure (the info-level Path B binding axis is verbose).
echo "pre-push: mnemosyne-cli validate-code-refs ..." >&2
if ! cr_out="$(mnemosyne-cli validate-code-refs 2>&1)"; then
    printf '%s\n' "$cr_out" | grep -E '\[(missing|section_missing)\]|violations: total' >&2 || true
    echo "pre-push: validate-code-refs found hallucination-class citations" >&2
    exit 1
fi

exit 0
