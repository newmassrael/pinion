#!/usr/bin/env bash
# Mnemosyne SSOT + clippy::pedantic deny gate — runs on every `git commit`.
#
# Blocks the commit if either gate trips:
#
#   1. `mnemosyne-cli validate-workspace`
#      - new T1 cross-ref orphans (not registered in [[orphan_ledger]])
#      - resolved ledger entries (entry stale, drift catch)
#      - round-trip mandatory dimension break
#
#   2. `cargo clippy --workspace --all-targets --features pinion-runtime/vello`
#      - workspace.lints baseline: forbid unsafe / deny warnings /
#        clippy::pedantic deny (Cargo.toml [workspace.lints])
#      - only runs when staged files include `*.rs`; atomic-only and
#        docs-only commits stay cheap. cargo's incremental cache keeps
#        Rust-touching commits fast once the workspace has been linted
#        once.
#
#   2b. `cargo doc --workspace --no-deps` (R1214) — broken intra-doc link
#      gate. `warnings = "deny"` promotes rustdoc lints to errors, so this
#      fails on any broken / redundant / private intra-doc link. Rides the
#      same `*.rs` gate as clippy and is near-free once clippy has warmed
#      the build. Absent before R1214, which let ~1000 links accrete from
#      ~R683 unseen.
#
#   3. `mnemosyne-cli validate-code-refs`
#      - hallucination-class citation gate: a source comment citing a
#        dead `§<id>` section or an unknown `Round NNN` entry fails the
#        commit (severity_missing = "reject" in mnemosyne.toml).
#      - runs only when staged files include `*.rs` / `*.scxml`; output
#        captured and surfaced only on failure (Path B binding axis is
#        info-level and verbose, so success stays silent).
#
# Install via:
#   git config core.hooksPath .githooks
# (one-time per clone; `.githooks/` is tracked, `.git/hooks/` is not)
set -euo pipefail

if ! command -v mnemosyne-cli >/dev/null 2>&1; then
    echo "pre-commit: mnemosyne-cli not on PATH — install with" >&2
    echo "  cargo install --path /path/to/mnemosyne/crates/mnemosyne-cli" >&2
    exit 1
fi

# Discover repo root and run from there so `mnemosyne.toml` discovery
# walks upward correctly regardless of where `git commit` was invoked.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mnemosyne-cli validate-workspace

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$'; then
    # R1026 §6.3 — rustfmt gate (rustfmt.toml, max_width=100). Runs before
    # clippy (cheaper, fail-fast) and only when staged files include `*.rs`.
    echo "pre-commit: cargo fmt --all --check ..." >&2
    cargo fmt --all --check
    echo "pre-commit: cargo clippy --workspace --all-targets --features pinion-runtime/vello ..." >&2
    cargo clippy --workspace --all-targets --features pinion-runtime/vello
    # R1214 — broken intra-doc link gate. `warnings = "deny"` (workspace.lints)
    # already promotes every rustdoc lint (broken_intra_doc_links /
    # redundant_explicit_links / private_intra_doc_links) to an error, so a
    # plain `cargo doc` fails on regression. This gate was absent until R1214,
    # which is why ~1000 broken links accreted invisibly from ~R683 (the
    # commit gate ran clippy, never rustdoc). Nearly free once clippy has
    # warmed the build (rustdoc reuses the compiled artifacts).
    echo "pre-commit: cargo doc --workspace --no-deps (broken intra-doc link gate) ..." >&2
    cargo doc --workspace --no-deps --features pinion-runtime/vello
fi

# 3. mnemosyne-cli validate-code-refs — hallucination-class citation gate
#    (dead §-section / unknown Round-id in source comments). severity_missing
#    is "reject" in mnemosyne.toml; Path B binding violations stay info.
#    Runs only when source citations could have changed (`.rs` / `.scxml`).
#    Output is captured and surfaced only on failure (the info-level binding
#    axis is verbose); success is silent.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(rs|scxml)$'; then
    echo "pre-commit: mnemosyne-cli validate-code-refs ..." >&2
    if ! cr_out="$(mnemosyne-cli validate-code-refs 2>&1)"; then
        printf '%s\n' "$cr_out" | grep -E '\[(missing|section_missing)\]|violations: total' >&2 || true
        echo "pre-commit: validate-code-refs found hallucination-class citations" >&2
        exit 1
    fi
fi
