#!/usr/bin/env bash
# Mnemosyne SSOT + clippy::pedantic deny gate — runs on every `git commit`.
#
# Blocks the commit if either gate trips:
#
#   1. `mnemosyne-cli validate-workspace`
#      - new T1 cross-ref orphans (not registered in [[orphan_ledger]])
#      - resolved ledger entries (entry stale, drift catch)
#      - round-trip mandatory dimension break
#
#   2. `cargo clippy --workspace --all-targets --features pinion-runtime/vello`
#      - workspace.lints baseline: forbid unsafe / deny warnings /
#        clippy::pedantic deny (Cargo.toml [workspace.lints])
#      - only runs when staged files include `*.rs`; atomic-only and
#        docs-only commits stay cheap. cargo's incremental cache keeps
#        Rust-touching commits fast once the workspace has been linted
#        once.
#
#   2b. `cargo doc --workspace --no-deps --document-private-items` (R1214,
#      R1218) — broken intra-doc link gate. `warnings = "deny"` promotes
#      rustdoc lints to errors, so this fails on any broken / redundant /
#      private intra-doc link. `--document-private-items` (R1218) extends
#      the check to PRIVATE items' docs — without it rustdoc only checks
#      public items, and ~150 private-item broken links were an ungated
#      blind spot. Rides the same `*.rs` gate as clippy and is near-free
#      once clippy has warmed the build. Absent before R1214, which let
#      ~1000 links accrete from ~R683 unseen.
#
#   3. `mnemosyne-cli validate-code-refs`
#      - hallucination-class citation gate: a source comment citing a
#        dead `§<id>` section or an unknown `Round NNN` entry fails the
#        commit (severity_missing = "reject" in mnemosyne.toml).
#      - runs only when staged files include `*.rs` / `*.scxml`; output
#        captured and surfaced only on failure (Path B binding axis is
#        info-level and verbose, so success stays silent).
#
# Install via:
#   git config core.hooksPath .githooks
# (one-time per clone; `.githooks/` is tracked, `.git/hooks/` is not)
set -euo pipefail

# Discover repo root and run from there so `mnemosyne.toml` discovery
# walks upward correctly regardless of where `git commit` was invoked.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# R1507 — resolve the PINNED tool rather than trusting PATH to delegate to it.
# `mnemosyne.toml [tool].pin` names the revision every gate result on this
# workspace is attributable to, and this hook now resolves that revision
# itself: the installed pin when its `--version` confirms it, else the
# `vendor/mnemosyne` submodule built from source. It never falls back to PATH.
# See lib/mnemosyne-tool.sh for why (a pre-R832 PATH binary dies before it can
# delegate, and a fresh clone has nothing to delegate to).
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/lib/mnemosyne-tool.sh
source "$hook_dir/lib/mnemosyne-tool.sh"
# shellcheck source=SCRIPTDIR/lib/consumer-tests.sh
source "$hook_dir/lib/consumer-tests.sh"
# shellcheck source=SCRIPTDIR/lib/worktree-guard.sh
source "$hook_dir/lib/worktree-guard.sh"

# A round is closed from the main tree; exploration worktrees may not commit.
# See lib/worktree-guard.sh for the split and why printing it was not enough.
#
# Deliberately ahead of `mnemosyne_resolve`, which can spend a minute building
# the pinned tool: a commit that is going to be refused for standing in the
# wrong tree should be refused before that minute is paid. (pre-push runs this
# same guard AFTER its library tests instead -- that hook has a stated rule
# about not deciding with libraries it has not verified, and this one has no
# such step to sit behind.)
require_main_worktree_for commit || exit 1

mnemosyne_resolve

echo "pre-commit: mnemosyne-cli validate-workspace ($MN_CLI_SOURCE) ..." >&2
mnemosyne_cli validate-workspace

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$'; then
    # R1026 §6.3 — rustfmt gate (rustfmt.toml, max_width=100). Runs before
    # clippy (cheaper, fail-fast) and only when staged files include `*.rs`.
    echo "pre-commit: cargo fmt --all --check ..." >&2
    cargo fmt --all --check
    # R1214 — broken intra-doc link gate. `warnings = "deny"` (workspace.lints)
    # already promotes every rustdoc lint (broken_intra_doc_links /
    # redundant_explicit_links / private_intra_doc_links) to an error, so a
    # plain `cargo doc` fails on regression. This gate was absent until R1214,
    # which is why ~1000 broken links accreted invisibly from ~R683 (the
    # commit gate ran clippy, never rustdoc). Nearly free once clippy has
    # warmed the build (rustdoc reuses the compiled artifacts).
    #
    # ⚠ CLIPPY AND THE DOC GATE ARE ONE UNIT, and the note above is why: rustdoc
    # is nearly free BECAUSE clippy warmed the build. Splitting them across
    # machines destroys exactly that — clippy warms one `target/`, rustdoc then
    # starts cold against another — so they travel together or not at all. The
    # `&&` keeps clippy's fail-fast: a clippy failure still exits without ever
    # documenting anything.
    #
    # ⚠ ROUTED THROUGH THE BUILD-MACHINE WRAPPER WHEN ONE IS CONFIGURED, because
    # this pair is the heaviest thing the hook does to the machine it runs on.
    # Measured 2026-08-19 on a 31GB workstation: the doc half alone spawned
    # EIGHT concurrent rustdocs (340MB-1GB each, one reaching 6.5GB in a sibling
    # repository), which pushed 13GB into swap and took the box to load 29 while
    # 82% of its CPU sat idle — every bit of that load was processes blocked on
    # the paging disk. Nothing was compute-bound; one uncapped command had put
    # the disk into thrash and every other session queued behind it.
    #
    # `$BX` IS AN OPT-IN AND ITS ABSENCE IS THE OLD BEHAVIOUR. Nothing about the
    # wrapper is named in this repository — no host, no path, no account (that
    # is deliberate: they belong to a machine, not to a public tree). A checkout
    # that does not set it runs the pair here, exactly as before, so this gate
    # never depends on tooling a contributor has no way to obtain.
    #
    # ⚠⚠ FAILING OPEN IS THE WRAPPER'S JOB, NOT THIS HOOK'S — and a version of
    # this block that did it here caused real harm.
    #
    # The rule this repository states for its CI check ("infrastructure absence
    # is not evidence of breakage, but always prints") is right, and the wrapper
    # already implements it: when no build machine is a candidate and this one
    # can hold the work, it runs the pair here and says `where=local`. It
    # declines only when it cannot proceed safely.
    #
    # The version this replaces read "no `bx: exit=` line" as "infrastructure
    # went away" and re-ran the pair locally. That line is absent for EVERY
    # reason the wrapper declines to start — an untracked file it does not
    # carry, a working tree the far side does not match, a floor no machine
    # meets — and every one of those is the author's to fix. Measured
    # 2026-08-20 in a sibling repository: six consecutive commits took that
    # path, running the heaviest gate on a workstation already at load 13-25
    # with 11GB in swap, while the log said only that the tree differed.
    #
    # So the wrapper's exit status IS the verdict, whatever produced it. A
    # refusal is a verdict too, and it prints its own reason.
    #
    # ⚠ IT COSTS A TRANSFER AND IT CAN LAND COLD. The wrapper syncs the tree
    # first — measured at 17s for this repository even when nothing changed —
    # and it picks whichever build machine is least loaded, which is not always
    # the one whose `target/` is warm. If commit latency matters more here than
    # the workstation's memory, unset `$BX` and this returns to running in place.
    lint_and_doc='cargo clippy --workspace --all-targets --features pinion-runtime/vello && cargo doc --workspace --no-deps --features pinion-runtime/vello --document-private-items'
    echo "pre-commit: cargo clippy --workspace --all-targets && cargo doc --workspace --no-deps --document-private-items ..." >&2
    if [ -n "${BX:-}" ] && [ -x "${BX}" ]; then
        "${BX}" --label pre-commit-lint -- bash -c "$lint_and_doc"
    else
        bash -c "$lint_and_doc"
    fi
fi

# 3. mnemosyne-cli validate-code-refs — hallucination-class citation gate
#    (dead §-section / unknown Round-id in source comments). severity_missing
#    is "reject" in mnemosyne.toml; Path B binding violations stay info.
#    Runs only when source citations could have changed (`.rs` / `.scxml`).
#    Output is captured and surfaced only on failure (the info-level binding
#    axis is verbose); success is silent.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(rs|scxml)$'; then
    echo "pre-commit: mnemosyne-cli validate-code-refs ..." >&2
    if ! cr_out="$(mnemosyne_cli validate-code-refs 2>&1)"; then
        printf '%s\n' "$cr_out" | grep -E '\[(missing|section_missing)\]|violations: total' >&2 || true
        echo "pre-commit: validate-code-refs found hallucination-class citations" >&2
        exit 1
    fi
fi

# 4. R1582 — the tests of the packages this change can BREAK.
#
#    "Test the crates this round touched" means the crates whose BEHAVIOUR
#    changed, and reading it as "the files I edited" is how R1497 and R1511
#    each shipped a broken consumer past a green gate. The radius is computed
#    from `cargo metadata` rather than remembered; see lib/consumer-tests.sh
#    for the cost measurement that decides when it runs here and when it is
#    reported and left to CI.
if ! consumer_test_gate "pre-commit" "$repo_root" staged; then
    exit 1
fi

# R1611 — the reference-name ratchet.
#
# A standing directive says other projects' names must not appear in what we
# publish. R1610 received it, zeroed its OWN output and registered the rest as
# debt, and nothing measured the rest: 7,999 occurrences across 501 files. A
# directive whose state nobody can see is a directive that grows. This makes the
# number monotone -- every push holds it or lowers it -- and refuses one that
# adds a name to a file, or a name to a file that had none.
echo "pre-commit: reference names ..." >&2
if ! python3 "$repo_root/tools/reference_names.py" --selftest >&2; then
    echo "pre-commit: the reference-name ratchet failed its own tests" >&2
    exit 1
fi
if ! python3 "$repo_root/tools/reference_names.py" --check >&2; then
    exit 1
fi

