<?xml version="1.0" encoding="UTF-8"?>
<!--
  R46.3 §5.16 first build-slice consumer for pinion-forge renderer kind.
  Emits a `DemoRenderer` Vello-backed struct that wraps Vello 0.6's
  RenderContext + RenderSurface + Renderer (zero virtual dispatch per
  §5.16 R45 "compile-time per target"). `aa` attribute omitted →
  defaults to Area per R46.2.1 (the UI-canonical mode; Vello/Xilem
  documented default). Backend selection lives here in the manifest,
  not at runtime — adding a thin-RHI backend (R41 Phase 2+) is a new
  RendererBackend variant + new emit template, no caller change.
-->
<pinion xmlns="https://pinion.dev/dsl/v1"
        kind="renderer"
        name="DemoRenderer"
        backend="vello"/>
