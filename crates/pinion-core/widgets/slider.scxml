<?xml version="1.0" encoding="UTF-8"?>
<!-- pinion §5.38 Round 51.7 — Slider widget statechart.

     Same shared interaction body as Button/Toggle/Checkbox/Radio
     via the `standard_button.sce-template.xml` template. Selects
     `slider.activate` event name; the pressed -> hover transition
     raises it on `pointer_up` (drag end).

     Semantic mapping at the statechart layer: "pressed" =
     "dragging". The value (`f32` in 0.0..=1.0) lives entirely in
     the Rust binding, mutated via [`Slider::set_value`] during
     drag (continuous "value_changing" intents) and committed on
     drag-end (single "value_committed" intent). This keeps Slider
     a SCE consumer of the same four-state body — no per-widget
     statechart divergence, the richness is in the binding.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       datamodel="null"
       initial="idle">

  <sce:use template="standard_button.sce-template.xml"
           activate_event="slider.activate"/>

</scxml>
