<?xml version="1.0" encoding="UTF-8"?>
<!-- pinion §5.16 Round 12.0 — Button widget statechart.

     R51.3 §5.38 refactor: the four-state interaction body lives in
     `standard_button.sce-template.xml` (shared with Toggle and
     future Checkbox / Radio / MenuItem / Tab / ...). This document
     selects the `button.activate` event name; the pressed -> hover
     transition raises it on `pointer_up`. The Rust binding
     (`Button` + `ButtonExternal`) listens for `button.activate` to
     emit a `"click"` intent with `IntrospectValue::Null` payload.

     Pressed -> idle on pointer_leave is the W3C button
     cancel-on-drag-off path. Disabled is an absorbing class until
     `enable` arrives. See the template file for full state /
     transition documentation.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       datamodel="null"
       initial="idle">

  <sce:use template="standard_button.sce-template.xml"
           activate_event="button.activate"/>

</scxml>
