<?xml version="1.0" encoding="UTF-8"?>
<!-- pinion §5.38 R51.2 — Toggle widget statechart.

     R51.3 refactor: the four-state interaction body lives in
     `standard_button.sce-template.xml` (shared with Button R12).
     This document selects the `toggle.activate` event name; the
     pressed -> hover transition raises it on `pointer_up`. The
     Rust binding (`Toggle` + `ToggleExternal`) listens for
     `toggle.activate` to flip a `value: bool` sidecar and emit a
     `"toggle"` intent carrying the new boolean as
     `IntrospectValue::Bool`.

     Pressed -> idle on pointer_leave is the cancel path (no flip,
     no intent). Disabled is an absorbing class until `enable`
     arrives. See the template file for full state / transition
     documentation.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       xmlns:sce="http://sce.dev/ext"
       version="1.0"
       datamodel="null"
       initial="idle">

  <sce:use template="standard_button.sce-template.xml"
           activate_event="toggle.activate"/>

</scxml>
