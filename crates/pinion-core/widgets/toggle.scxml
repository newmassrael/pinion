<?xml version="1.0" encoding="UTF-8"?>
<!-- pinion §5.38 Round 51.2 — Toggle widget state machine.

     Same 4-state interaction shape as the §5.16 R12 Button
     (idle/hover/pressed/disabled), per §5.38 rationale: interaction
     state pattern is shared across Tier-1 widgets, the divergence is
     value semantics.

     Activation semantics: pressed → hover transition on pointer_up
     emits a "toggle.activate" internal event (analogous to Button's
     "button.activate"). The Rust binding (Toggle struct) listens
     and flips its `value: bool` Off ↔ On on each activate, emitting
     a "toggle" intent carrying the new boolean value.

     Pressed → idle on pointer_leave is the cancel path (no flip,
     no intent), matching the W3C button cancel-on-drag-off shape.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
       version="1.0"
       datamodel="null"
       initial="idle">

  <state id="idle">
    <transition event="pointer_enter" target="hover"/>
    <transition event="disable" target="disabled"/>
  </state>

  <state id="hover">
    <transition event="pointer_leave" target="idle"/>
    <transition event="pointer_down" target="pressed"/>
    <transition event="disable" target="disabled"/>
  </state>

  <state id="pressed">
    <transition event="pointer_up" target="hover">
      <raise event="toggle.activate"/>
    </transition>
    <transition event="pointer_leave" target="idle"/>
    <transition event="disable" target="disabled"/>
  </state>

  <state id="disabled">
    <transition event="enable" target="idle"/>
  </state>

</scxml>
