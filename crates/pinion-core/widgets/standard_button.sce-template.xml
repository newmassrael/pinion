<?xml version="1.0" encoding="UTF-8"?>
<!-- pinion §5.38 / §5.16 R51.3 — Tier-1 button-like widget body.

     Shared four-state interaction body for button-like Tier-1
     widgets (Button R12, Toggle R51.2, future Checkbox / Radio /
     MenuItem / Tab / ...). Spliced into a caller's <scxml> root via
     SCE's sce:template / sce:use mechanism (vendor/sce
     sce-build/src/template.rs, RFC §6.5 Phase A).

     States: idle / hover / pressed / disabled — following W3C
     SCXML 1.0 + pinion §5.13 closed-core pointer/enable events
     (PointerEnter, PointerLeave, PointerDown, PointerUp, disable,
     enable). Pressed -> hover on pointer_up raises the
     `activate_event` parameter, which the per-widget Rust binding
     listens to (Button -> click intent, Toggle -> value flip +
     toggle intent, future Checkbox -> checked toggle, etc.).

     Pressed -> idle on pointer_leave is the cancel path (no
     activate event), matching W3C button cancel-on-drag-off.
     Disabled is an absorbing class until enable arrives; pointer
     events fired while disabled are silently ignored.

     The only variation between consumers is the `activate_event`
     name. Adding a new button-like widget = a new <scxml> root
     with one <sce:use activate_event="..."/> line; statechart
     body lives here, in one place.
-->
<sce:template xmlns="http://www.w3.org/2005/07/scxml"
              xmlns:sce="http://sce.dev/ext"
              name="standard_button">
  <sce:param name="activate_event" required="true"/>

  <!-- R51.54 §5.39 — ARIA keyboard activation. Space / Enter on a
       focused button-like widget translates to `keyboard_activate`,
       an internal (no target) transition from `idle` or `hover` that
       raises the activate event without changing visual state. This
       matches the W3C ARIA Button keyboard pattern: focus +
       Space/Enter = a click without requiring a pointer-down
       sequence. `disabled` ignores the activation per ARIA spec
       (no transition); `pressed` would conflict with an in-flight
       pointer drag and is also intentionally absent — keyboard
       activation in the middle of a pointer drag is a user-error
       race rather than a meaningful event. -->

  <!-- R51.93 §5.35 §5.13 — pointer_cancel is the touch-cancel
       sibling of pointer_up. winit's `TouchPhase::Cancelled`
       (4-finger system gesture, phone call interrupt, notification
       pull-down, app-switcher invocation, edge-swipe back nav —
       any OS-side gesture that revokes an in-flight touch) routes
       here. Semantic axis vs pointer_up: `pointer_up` is the
       user's commit signal that activates the widget; `pointer_cancel`
       is the OS revoke signal that must NOT commit. From `pressed`
       we transition straight to `idle` (skipping the `pressed →
       hover` activate path) so the click / toggle / selected /
       value_committed intent never fires. From `hover` we similarly
       drop to `idle` defensively (cancellation mid-hover should
       not leave the visual stuck on hover when the cursor is in
       fact gone). `idle` / `disabled` ignore the event (no
       transition declared — SCXML's default no-op silently absorbs
       it). Touch's trailing `cursor_left` still runs at the shell
       layer, so any `hover → idle` cleanup it would have done is
       still reached. -->

  <state id="idle">
    <transition event="pointer_enter" target="hover"/>
    <transition event="keyboard_activate">
      <raise event="{$activate_event}"/>
    </transition>
    <transition event="disable" target="disabled"/>
  </state>

  <state id="hover">
    <transition event="pointer_leave" target="idle"/>
    <transition event="pointer_cancel" target="idle"/>
    <transition event="pointer_down" target="pressed"/>
    <transition event="keyboard_activate">
      <raise event="{$activate_event}"/>
    </transition>
    <transition event="disable" target="disabled"/>
  </state>

  <state id="pressed">
    <transition event="pointer_up" target="hover">
      <raise event="{$activate_event}"/>
    </transition>
    <transition event="pointer_leave" target="idle"/>
    <transition event="pointer_cancel" target="idle"/>
    <transition event="disable" target="disabled"/>
  </state>

  <state id="disabled">
    <transition event="enable" target="idle"/>
  </state>

</sce:template>
